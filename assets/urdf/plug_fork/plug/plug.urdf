<?xml version="1.0"?>
<!--
  Apple 20 W USB-C power adapter, model A2940 (the iPhone 15-era
  charger), built to published dimensions: 41.5 x 42.5 x 27 mm, 58.5 g,
  per the chargerlab teardown. Prongs are NEMA 1-15P: 1.5 mm thick,
  6.3 / 7.9 mm wide, 12.7 mm pitch, and FIXED (this model does not fold),
  so a rigid single body is exact rather than an approximation.

  This is the task reviewers asked for by name: a naturally sized
  electric plug. Its 1.5 mm blades are an order of magnitude below any
  feature in the existing suite, and unlike every other task here it is
  a TWO-feature insertion - both blades enter at once, so the contact
  itself constrains yaw.

  visual    : boolean-cut shell (corner rounds, USB-C recess, seam)
  collision : 3 exact boxes, body + two prongs
-->
<robot name="apple_20w_plug">
  <link name="apple_20w_plug">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="plug_visual.glb"/></geometry>
    </visual>
    <collision>
      <origin xyz="0.000000 0.000000 0.000000" rpy="0 0 0"/>
      <geometry><box size="0.027000 0.042500 0.041500"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.021450 0.000000 -0.006350" rpy="0 0 0"/>
      <geometry><box size="0.015900 0.006300 0.001500"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.021450 0.000000 0.006350" rpy="0 0 0"/>
      <geometry><box size="0.015900 0.007900 0.001500"/></geometry>
    </collision>
    <inertial>
      <mass value="0.058500"/>
      <origin xyz="-0.000151 0.000000 0.000005" rpy="0 0 0"/>
      <inertia ixx="1.709850e-05" ixy="1.345292e-22" ixz="6.295194e-09" iyy="1.207962e-05" iyz="-0.000000e+00" izz="1.247130e-05"/>
    </inertial>
  </link>
</robot>
