+        wp.vec3(s_np),
+        wp.vec3(qvel_rot_np),
+      ],
+      outputs=[lin_wp, rot_wp],
+    )
+
+    np.testing.assert_allclose(lin_wp.numpy(), lin_ref, atol=1e-5, rtol=1e-5)
+    np.testing.assert_allclose(rot_wp.numpy(), rot_ref, atol=1e-5, rtol=1e-5)
